generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PurchaseSource {
  MANUAL
  CSV
  RECEIPT
  DEMO
}

enum MatchConfidence {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum MatchStatus {
  UNREVIEWED
  REVIEWED
  DISMISSED
  RETURNED
  DISCARDED
}

model Purchase {
  id           String         @id @default(cuid())
  householdId  String?
  household    Household?     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  productName  String
  brand        String
  category     String
  retailer     String
  purchaseDate DateTime
  upc          String?
  lotNumber    String?
  source       PurchaseSource @default(MANUAL)
  createdAt    DateTime       @default(now())
  matches      RecallMatch[]

  @@index([purchaseDate])
  @@index([upc])
  @@index([householdId, createdAt])
}

model AppUser {
  id         String      @id
  createdAt  DateTime    @default(now())
  membership Membership?
  notificationEmail String?
  emailAlertsEnabled Boolean @default(false)
  emailAlertsConsentedAt DateTime?
  unsubscribeToken String? @unique
  emailNotifications EmailNotification[]
  businessMemberships BusinessMembership[]
}

enum BusinessRole {
  OWNER
  MANAGER
  STAFF
}

model Organization {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  authorizationVersion Int @default(0)
  members BusinessMembership[]
  locations BusinessLocation[]
  invitations BusinessInvitation[]
}

model BusinessMembership {
  id String @id @default(cuid())
  organizationId String
  userId String
  email String
  role BusinessRole @default(STAFF)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model BusinessLocation {
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  address String @default("")
  archivedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model BusinessInvitation {
  id String @id @default(cuid())
  organizationId String
  email String
  role BusinessRole @default(STAFF)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Household {
  id        String       @id @default(cuid())
  name      String       @default("My household")
  createdAt DateTime     @default(now())
  members   Membership[]
  purchases Purchase[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String    @unique
  householdId String
  role        String    @default("OWNER")
  user        AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Recall {
  id                    String        @id @default(cuid())
  externalId            String
  sourceAuthority       String
  headline              String
  description           String
  brand                  String
  productName            String
  category               String
  upcs                    String        @default("[]")
  lotNumbers             String        @default("[]")
  distributionStartDate DateTime?
  distributionEndDate   DateTime?
  recallDate             DateTime
  severity               String?
  recommendedAction      String
  sourceUrl               String
  rawData                 String        @default("{}")
  isFixture               Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  matches                 RecallMatch[]

  @@unique([sourceAuthority, externalId])
  @@index([recallDate])
}

model RecallMatch {
  id         String          @id @default(cuid())
  purchaseId String
  recallId   String
  confidence MatchConfidence
  score      Float
  reasons    String          @default("[]")
  status     MatchStatus     @default(UNREVIEWED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  purchase   Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  recall     Recall          @relation(fields: [recallId], references: [id], onDelete: Cascade)
  emailNotifications EmailNotification[]

  @@unique([purchaseId, recallId])
  @@index([confidence, status])
  @@index([recallId])
}

model EmailNotification {
  id String @id @default(cuid())
  dedupeKey String @unique
  userId String
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId String?
  match RecallMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  firstAttemptAt DateTime?
  lockedAt DateTime?
  sentAt DateTime?
  providerMessageId String?
  lastError String?
  createdAt DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([matchId])
}

model SyncState {
  id            String    @id
  provider      String
  syncedAt      DateTime
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  status        String    @default("SUCCEEDED")
  errorMessage  String?
  recordCount   Int
}
