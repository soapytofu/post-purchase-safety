generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PurchaseSource {
  MANUAL
  CSV
  RECEIPT
  DEMO
}

enum MatchConfidence {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum MatchStatus {
  UNREVIEWED
  REVIEWED
  DISMISSED
  RETURNED
  DISCARDED
}

model Purchase {
  id           String         @id @default(cuid())
  householdId  String?
  household    Household?     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  productName  String
  brand        String
  category     String
  retailer     String
  purchaseDate DateTime
  upc          String?
  lotNumber    String?
  source       PurchaseSource @default(MANUAL)
  createdAt    DateTime       @default(now())
  matches      RecallMatch[]

  @@index([purchaseDate])
  @@index([upc])
  @@index([householdId, createdAt])
}

model AppUser {
  id         String      @id
  createdAt  DateTime    @default(now())
  membership Membership?
  notificationEmail String?
  emailAlertsEnabled Boolean @default(false)
  emailAlertsConsentedAt DateTime?
  unsubscribeToken String? @unique
  emailNotifications EmailNotification[]
  businessMemberships BusinessMembership[]
}

enum BusinessRole {
  OWNER
  MANAGER
  STAFF
}

model Organization {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  authorizationVersion Int @default(0)
  members BusinessMembership[]
  locations BusinessLocation[]
  invitations BusinessInvitation[]
  inventoryImports InventoryImport[]
  recallCases BusinessRecallCase[]
}

model BusinessMembership {
  id String @id @default(cuid())
  organizationId String
  userId String
  email String
  role BusinessRole @default(STAFF)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model BusinessLocation {
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  address String @default("")
  archivedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentSnapshotId String? @unique
  currentSnapshot InventorySnapshot? @relation("CurrentInventory", fields: [currentSnapshotId], references: [id], onDelete: Restrict)
  snapshots InventorySnapshot[] @relation("LocationInventory")
  recallCases BusinessRecallCase[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
}

model InventoryImport {
  id String @id @default(cuid())
  organizationId String
  createdById String
  fileName String
  contentHash String
  appliedHash String?
  status String @default("DRAFT")
  payload String
  createdAt DateTime @default(now())
  expiresAt DateTime
  appliedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  snapshots InventorySnapshot[]

  @@index([organizationId, createdById, contentHash])
  @@unique([organizationId, appliedHash])
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
}

model InventorySnapshot {
  id String @id @default(cuid())
  organizationId String
  locationId String
  importId String
  inventoryAsOf DateTime
  createdAt DateTime @default(now())
  location BusinessLocation @relation("LocationInventory", fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  currentFor BusinessLocation? @relation("CurrentInventory")
  import InventoryImport @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Restrict)
  rows InventoryStockRow[]

  @@unique([id, locationId, organizationId])
  @@index([locationId, organizationId])
  @@index([importId, organizationId])
}

model InventoryStockRow {
  id String @id @default(cuid())
  organizationId String
  locationId String
  snapshotId String
  stockKey String
  sku String
  productName String
  quantityOnHand Int
  brand String @default("")
  gtin String @default("")
  manufacturer String @default("")
  modelNumber String @default("")
  lotNumber String @default("")
  serialNumber String @default("")
  productionDate String @default("")
  supplier String @default("")
  category String @default("")
  snapshot InventorySnapshot @relation(fields: [snapshotId, locationId, organizationId], references: [id, locationId, organizationId], onDelete: Restrict)
  caseObservations BusinessCaseObservation[]

  @@unique([snapshotId, stockKey])
  @@unique([id, locationId, organizationId])
  @@index([organizationId, locationId])
  @@index([snapshotId, locationId, organizationId])
}

model BusinessInvitation {
  id String @id @default(cuid())
  organizationId String
  email String
  role BusinessRole @default(STAFF)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Independent of the mutable live catalog: source pruning cannot erase history.
model NoticeHistory {
  id String @id @default(cuid())
  sourceAuthority String
  externalId String
  revisionCount Int @default(0)
  currentHash String @default("")
  lockVersion Int @default(0)
  createdAt DateTime @default(now())
  revisions NoticeRevision[]
  cases BusinessRecallCase[]

  @@unique([sourceAuthority, externalId])
}

model NoticeRevision {
  id String @id @default(cuid())
  historyId String
  number Int
  contentHash String
  payload String
  observedAt DateTime @default(now())
  observationSource String
  history NoticeHistory @relation(fields: [historyId], references: [id], onDelete: Restrict)
  observations BusinessCaseObservation[]

  @@unique([historyId, number])
  @@unique([id, historyId])
}

model BusinessRecallCase {
  id String @id @default(cuid())
  organizationId String
  locationId String
  stockKey String
  noticeHistoryId String
  status String @default("NEEDS_REVIEW")
  affectedQuantity Int?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location BusinessLocation @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  noticeHistory NoticeHistory @relation(fields: [noticeHistoryId], references: [id], onDelete: Restrict)
  observations BusinessCaseObservation[]
  events BusinessCaseEvent[]

  @@unique([organizationId, locationId, stockKey, noticeHistoryId], map: "BusinessRecallCase_scope_key")
  @@unique([id, organizationId])
  @@unique([id, locationId, organizationId, noticeHistoryId], map: "BusinessRecallCase_evidence_scope_key")
  @@index([organizationId, updatedAt])
  @@index([locationId, organizationId])
  @@index([noticeHistoryId])
}

model BusinessCaseObservation {
  id String @id @default(cuid())
  caseId String
  sequence Int
  organizationId String
  locationId String
  stockRowId String
  noticeHistoryId String
  noticeRevisionId String
  algorithmVersion String
  matchKind String
  evidence String
  stockEvidence String
  observedById String
  createdAt DateTime @default(now())
  case BusinessRecallCase @relation(fields: [caseId, locationId, organizationId, noticeHistoryId], references: [id, locationId, organizationId, noticeHistoryId], onDelete: Restrict)
  stockRow InventoryStockRow @relation(fields: [stockRowId, locationId, organizationId], references: [id, locationId, organizationId], onDelete: Restrict)
  noticeRevision NoticeRevision @relation(fields: [noticeRevisionId, noticeHistoryId], references: [id, historyId], onDelete: Restrict)

  @@unique([caseId, stockRowId, noticeRevisionId, algorithmVersion], map: "BusinessCaseObservation_dedupe_key")
  @@unique([caseId, sequence])
  @@index([stockRowId, locationId, organizationId])
  @@index([noticeRevisionId, noticeHistoryId])
  @@index([caseId, locationId, organizationId, noticeHistoryId], map: "BusinessCaseObservation_scope_idx")
}

model BusinessCaseEvent {
  id String @id @default(cuid())
  caseId String
  organizationId String
  version Int
  actorId String
  kind String
  payload String
  createdAt DateTime @default(now())
  case BusinessRecallCase @relation(fields: [caseId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([caseId, version])
  @@index([caseId, organizationId])
}

model Household {
  id        String       @id @default(cuid())
  name      String       @default("My household")
  createdAt DateTime     @default(now())
  members   Membership[]
  purchases Purchase[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String    @unique
  householdId String
  role        String    @default("OWNER")
  user        AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Recall {
  id                    String        @id @default(cuid())
  externalId            String
  sourceAuthority       String
  headline              String
  description           String
  brand                  String
  productName            String
  category               String
  upcs                    String        @default("[]")
  lotNumbers             String        @default("[]")
  distributionStartDate DateTime?
  distributionEndDate   DateTime?
  recallDate             DateTime
  severity               String?
  recommendedAction      String
  sourceUrl               String
  rawData                 String        @default("{}")
  isFixture               Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  matches                 RecallMatch[]

  @@unique([sourceAuthority, externalId])
  @@index([recallDate])
}

model RecallMatch {
  id         String          @id @default(cuid())
  purchaseId String
  recallId   String
  confidence MatchConfidence
  score      Float
  reasons    String          @default("[]")
  status     MatchStatus     @default(UNREVIEWED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  purchase   Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  recall     Recall          @relation(fields: [recallId], references: [id], onDelete: Cascade)
  emailNotifications EmailNotification[]

  @@unique([purchaseId, recallId])
  @@index([confidence, status])
  @@index([recallId])
}

model EmailNotification {
  id String @id @default(cuid())
  dedupeKey String @unique
  userId String
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId String?
  match RecallMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  firstAttemptAt DateTime?
  lockedAt DateTime?
  sentAt DateTime?
  providerMessageId String?
  lastError String?
  createdAt DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([matchId])
}

model SyncState {
  id            String    @id
  provider      String
  syncedAt      DateTime
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  status        String    @default("SUCCEEDED")
  errorMessage  String?
  recordCount   Int
}
