DATABASE_URL="file:./dev.db"
# Optional. Anonymous openFDA access works at lower daily limits.
FDA_API_KEY=""
# Required only for POST /api/sync. Generate a random value of at least 24 characters.
SYNC_SECRET=""
# Local mode only permits loopback development. Hosted mode has no local bypass.
AUTH_MODE="local"
# For hosted mode set AUTH_MODE=supabase and these public (not service-role) values.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
APP_URL="http://127.0.0.1:3001"
